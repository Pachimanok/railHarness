# Rail Harness runtime configuration — copy to `.env` and fill in.
# NEVER commit a real token. `.env` is gitignored.

# --- Required (every mode) ---
RAIL_API_URL=            # e.g. https://<host>/api/rail   (https, or http only for localhost)
RAIL_TOKEN=              # Rail agent bearer token — secret, never logged
RAIL_PROJECT_ID=         # Rail project id the Harness is bound to
RAIL_REPO_PATH=          # absolute path to the local clone of the target repository

# --- Optional ---
RAIL_MACHINE=            # machine id sent as X-Rail-Machine (default: hostname)
RAIL_AGENT=              # label sent as X-Rail-Agent (default: rail-harness)
RAIL_BASE_BRANCH=        # override base branch detection (e.g. main / master)

# --- Worker Core cadence (npm run worker) ---
RAIL_HEARTBEAT_INTERVAL_MS=   # lease-renewal interval, ms (default: 300000). Must be < the Rail lease.
RAIL_DISCOVERY_POLL_MS=       # idle READY-queue poll interval, ms (default: 30000)

# --- Workspace Manager (src/workspace/) ---
RAIL_WORKSPACE_ROOT=     # absolute dir; each ticket gets its own isolated git worktree under it
                        # (RAIL_BASE_BRANCH above is the base for a brand-new ticket branch)

# --- Orchestration (src/orchestration/) ---
RAIL_ADAPTER_PROVIDER=   # explicit adapter provider through the AdapterRouter (default: claude-code)

# --- Mode selectors (RAIL_TICKET_REF / RAIL_RESUME_REF / RAIL_RECOVER_REF are mutually exclusive) ---
RAIL_TICKET_REF=         # claim exactly this ticket instead of discovering the first READY
RAIL_RESUME_REF=         # GENERAL governed /resume of this NON-terminal cycle (state preserved);
                        # ownerless last Run may be COMPLETED/RELEASED/FAILED/ABANDONED
RAIL_RESUME_NOTES=       # optional operator context -> /resume body.reason
RAIL_RECOVER_REF=        # COMPAT governed /recover of this orphaned IN_PROGRESS cycle (FAILED/ABANDONED)
RAIL_RECOVER_NOTES=      # optional operator context -> /recover body.reason
